# Online rooms use Supabase Realtime (free tier). See README.md → "Backend setup".
# Both values are safe to expose in the browser (they are the public "anon" credentials).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional. Set to "local" to run online rooms between tabs of ONE browser
# (BroadcastChannel, no backend) — handy for development and automated tests.
# VITE_ONLINE_TRANSPORT=local
